<!-- SVG Placeholder - Replace this file with your actual poster image -->
<svg width="600" height="900" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ff6b35;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f7931e;stop-opacity:1" />
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
    </pattern>
  </defs>

  <!-- Background -->
  <rect width="600" height="900" fill="url(#grad1)"/>
  <rect width="600" height="900" fill="url(#grid)"/>

  <!-- Title -->
  <text x="300" y="400" font-family="Arial, sans-serif" font-size="80" font-weight="bold"
        text-anchor="middle" fill="white" letter-spacing="8">
    THAT
  </text>
  <text x="300" y="500" font-family="Arial, sans-serif" font-size="80" font-weight="bold"
        text-anchor="middle" fill="white" letter-spacing="8">
    FRIEND
  </text>

  <!-- Subtitle -->
  <text x="300" y="560" font-family="Arial, sans-serif" font-size="20"
        text-anchor="middle" fill="rgba(255,255,255,0.8)" letter-spacing="4">
    AN INDIE BROMANCE COMEDY
  </text>

  <!-- Cast -->
  <text x="300" y="650" font-family="Arial, sans-serif" font-size="24" font-weight="bold"
        text-anchor="middle" fill="white">
    HARVEY GUILLEN
  </text>
  <text x="300" y="690" font-family="Arial, sans-serif" font-size="24" font-weight="bold"
        text-anchor="middle" fill="white">
    BILLIE LOURD
  </text>
  <text x="300" y="730" font-family="Arial, sans-serif" font-size="24" font-weight="bold"
        text-anchor="middle" fill="white">
    JOSH BRENER
  </text>

  <!-- Bottom text -->
  <text x="300" y="820" font-family="Arial, sans-serif" font-size="16"
        text-anchor="middle" fill="rgba(255,255,255,0.7)">
    PRODUCED BY STRAW HUT MEDIA
  </text>
  <text x="300" y="850" font-family="Arial, sans-serif" font-size="14"
        text-anchor="middle" fill="rgba(255,255,255,0.6)">
    Replace this placeholder with your official poster
  </text>
</svg>
